server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # 壓縮文字類檔案，Three.js 從 2 MB 變 500 KB 左右
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 安全標頭：跟 firebase.json 裡的一模一樣，兩種部署行為一致
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" always;

    # Three.js 放 vendor，版本換了檔名路徑不變，所以只快取一天
    location /vendor/ {
        expires 1d;
    }
    location = /index.html {
        expires -1;
    }
}
